	partition station_ranking = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\station_ranking.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"period", type text}, {"period_sort", Int64.Type}, {"period_start", type date}, {"period_end", type date}, {"station_key", Int64.Type}, {"station_label", type text}, {"line_code", type text}, {"incidents", Int64.Type}, {"delay_minutes", type number}, {"naive_minutes_per_incident", type number}, {"line_minutes_per_incident", type number}, {"within_variance", type number}, {"line_within_variance", type number}, {"between_variance", type number}, {"shrinkage_weight", type number}, {"shrunk_minutes_per_incident", type number}, {"count_rank", Int64.Type}, {"naive_rank", Int64.Type}, {"shrunk_rank", Int64.Type}, {"rank_change", Int64.Type}, {"explanation", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
